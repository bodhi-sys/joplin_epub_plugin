{
  "compilerOptions": {
    "outDir": "./dist/",
    "module": "commonjs",
    "target": "es2018",
    "jsx": "react",
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "api": ["api/index.ts"],
      "api/*": ["api/*"]
    },
    "typeRoots": [
      "./node_modules/@types"
    ],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*"
  ]
}
